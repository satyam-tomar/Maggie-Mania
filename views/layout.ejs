<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Maggie - Hot & Delicious' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <span class="brand-icon">🍜</span>
        <span class="brand-text">Maggie Express</span>
      </div>
      <div class="nav-links">
        <% if (user) { %>
          <span class="user-name">Hi, <%= user.name.split(' ')[0] %></span>
          <a href="/orders/my-orders" class="nav-link">My Orders</a>
          <a href="/auth/logout" class="nav-link logout-btn">Logout</a>
        <% } else { %>
          <a href="/auth/google" class="nav-link login-btn">Login with Google</a>
        <% } %>
      </div>
    </div>
  </nav>
  
  <%- body %>
  
  <footer class="footer">
    <p>&copy; 2025 Maggie Express. Made with ❤️ for Maggie lovers</p>
  </footer>
</body>
</html>