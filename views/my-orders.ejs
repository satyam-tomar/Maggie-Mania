<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders - Maggie Express</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="discount-bar">
    Every room will get <strong>20% discount</strong> on first order!
  </div>
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <span class="brand-icon">🍜</span>
        <span class="brand-text">Maggie Express</span>
      </div>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <span class="user-name">Hi, <%= user.name.split(' ')[0] %></span>
        <a href="/auth/logout" class="nav-link logout-btn">Logout</a>
      </div>
    </div>
  </nav>

  <div class="orders-container">
    <h1 class="orders-title">My Orders</h1>

    <% if (orders.length === 0) { %>
      <div class="empty-orders">
        <div class="empty-icon">🍜</div>
        <h2>No orders yet!</h2>
        <p>Start ordering your favorite Maggie now</p>
        <a href="/" class="btn-primary">Order Now</a>
      </div>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach(order => { %>
          <div class="order-card">
            <div class="order-header">
              <div class="order-id-badge">
                <span>Order #<%= order._id.toString().slice(-8).toUpperCase() %></span>
                <span class="status-badge status-<%= order.status.toLowerCase().replace(' ', '-') %>">
                  <%= order.status %>
                </span>
              </div>
              <div class="order-date">
                <%= new Date(order.orderDate).toLocaleDateString('en-IN', { 
                  day: 'numeric', 
                  month: 'short', 
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }) %>
              </div>
            </div>

            <div class="order-items-list">
              <% order.items.forEach(item => { %>
                <div class="order-item-row">
                  <span class="item-name"><%= item.name %> × <%= item.quantity %></span>
                  <span class="item-price">₹<%= (item.price * item.quantity + item.masalaCost).toFixed(0) %></span>
                </div>
                <% if (item.hasExtraMasala) { %>
                  <div class="order-item-extra">+ Extra Masala</div>
                <% } %>
              <% }); %>
            </div>

            <div class="order-footer">
              <div class="order-delivery">
                📍 Room <%= order.deliveryDetails.roomNumber %>, <%= order.deliveryDetails.block %> Block
              </div>
              <div class="order-total">
                Total: <strong>₹<%= order.totalAmount %></strong>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    <p>&copy; 2025 Maggie Express. Made with ❤️ for Maggie lovers</p>
  </footer>
</body>
</html>