<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 30px;
      background: #f5f5f5;
    }
    h2 {
      margin: 40px 0 15px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      font-size: 14px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 10px;
      vertical-align: top;
    }
    th {
      background: #f1f1f1;
    }
    ul {
      margin: 0;
      padding-left: 18px;
    }
  </style>
</head>
<body>

<h2>Users</h2>

<table>
  <tr>
    <th>Name</th>
    <th>Email</th>
    <th>Phone</th>
    <th>Hostel</th>
    <th>Block</th>
    <th>Room</th>
    <th>Joined</th>
  </tr>
  <% users.forEach(user => { %>
    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td><%= user.phone %></td>
      <td><%= user.hostel %></td>
      <td><%= user.block %></td>
      <td><%= user.roomNumber %></td>
      <td><%= user.createdAt.toLocaleString() %></td>
    </tr>
  <% }) %>
</table>

<h2>Orders List</h2>

<table>
  <tr>
    <th>Order ID</th>
    <th>User Info</th>
    <th>Delivery Address</th>
    <th>Items</th>
    <th>Total</th>
    <th>Payment</th>
    <th>Status</th>
    <th>Date & Time</th>
  </tr>

  <% orders.forEach(order => { %>
    <tr>
      <td><%= order._id %></td>

      <td>
        <strong>Name:</strong> <%= order.userId.name %><br>
        <strong>Phone:</strong> <%= order.userId.phone %><br>
        <strong>Email:</strong> <%= order.userId.email %>
      </td>

      <td>
        Hostel: <%= order.deliveryDetails.hostel %><br>
        Block: <%= order.deliveryDetails.block %><br>
        Room: <%= order.deliveryDetails.roomNumber %>
      </td>

      <td>
        <ul>
          <% order.items.forEach(item => { %>
            <li>
              <strong><%= item.name %></strong><br>
              Qty: <%= item.quantity %> |
              ₹<%= item.price %><br>
              Masala: <%= item.hasExtraMasala ? 'Yes' : 'No' %>
              <% if (item.hasExtraMasala) { %>
                (₹<%= item.masalaCost %>)
              <% } %>
            </li>
          <% }) %>
        </ul>
      </td>

      <td>₹<%= order.totalAmount %></td>

      <td><%= order.paymentMethod %></td>

      <td><%= order.status %></td>

      <td>
        <%= order.orderDate.toLocaleDateString() %><br>
        <%= order.orderDate.toLocaleTimeString() %>
      </td>
    </tr>
  <% }) %>
</table>

</body>
</html>
